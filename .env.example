# Alibaba Cloud Model Studio (DashScope) API key: https://modelstudio.console.alibabacloud.com/
DASHSCOPE_API_KEY=sk-your-key
# International (Singapore) endpoint. For the Beijing region use https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# Optional model overrides, e.g. wan2.6-i2v-flash for faster/cheaper continuation segments
# WAN_T2V_MODEL=wan2.6-t2v
# WAN_I2V_MODEL=wan2.6-i2v
