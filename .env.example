# Which backend to use by default: local (free, Wan2.2 on your GPU), dashscope (paid Wan2.6 API), mock
WAN_BACKEND=local

# --- local (free) ---
# WAN_LOCAL_PRESET=ti2v-5B          # or a14b (needs ~80 GB VRAM)
# WAN_REPO_DIR=third_party/Wan2.2   # where scripts/setup_local.sh cloned Wan2.2
# WAN_MODELS_DIR=models             # where it downloaded the weights

# --- dashscope (paid Wan2.6 API) ---
# Key from https://modelstudio.console.alibabacloud.com/
# DASHSCOPE_API_KEY=sk-your-key
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# WAN_T2V_MODEL=wan2.6-t2v
# WAN_I2V_MODEL=wan2.6-i2v
